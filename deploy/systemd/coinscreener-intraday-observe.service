[Unit]
Description=Record cache-backed intraday danta observations
After=network.target upbit-crawler.service

[Service]
Type=oneshot
User=i_am_psw86
WorkingDirectory=/home/i_am_psw86/myapp
ExecStart=/home/i_am_psw86/myapp/venv/bin/python manage.py observe_intraday_danta --limit 50
Nice=10
IOSchedulingClass=idle


