[Unit]
Description=Coin Screener verified SQLite backup
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/i_am_psw86/myapp/db.sqlite3

[Service]
Type=oneshot
User=i_am_psw86
Group=i_am_psw86
WorkingDirectory=/home/i_am_psw86/myapp
EnvironmentFile=-/home/i_am_psw86/myapp/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/i_am_psw86/myapp/venv/bin/python manage.py backup_sqlite --keep 14
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=15min
